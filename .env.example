PROJECT_NAME="SHAP-LLM Explainability Platform"
DEBUG=False
# Required. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="generate-a-secure-random-secret-key-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite+aiosqlite:///./xai_app.db"
BACKEND_PORT=8001

# Ollama (NFR-2: must be a loopback address unless ALLOW_REMOTE_LLM=true)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma:2b"
# ALLOW_REMOTE_LLM=true

# Upload policy. Pickle formats (.joblib/.pkl) execute code on load; set to False to accept only .skops
ALLOW_PICKLE_MODELS=True
MAX_MODEL_UPLOAD_MB=250
MAX_DATASET_UPLOAD_MB=100

# Local demo account used for UI walkthroughs (test-only, local SQLite DB)
# DEMO_USER_EMAIL=demo.walkthrough@cbox.test
# DEMO_USER_PASSWORD=Cbx-arYgCIRudA6kzvA1
